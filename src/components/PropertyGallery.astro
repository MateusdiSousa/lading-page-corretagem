---
import {getImageUrl} from '../data/site/image';


interface Props {
  title: string;
  image?: string;
  gallery?: string[];
}

const {
  title,
  image,
  gallery = [],
} = Astro.props;

/*
 * Monta a lista de imagens.
 *
 * Se existir gallery, usamos ela.
 * Caso contrário, usamos apenas a imagem principal.
 */
const images = gallery.length > 0
  ? gallery
  : image
    ? [image]
    : [];

/*
 * Endpoint público do ImageKit.
 *
 * No .env:
 *
 * PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/SEU_ID
 */

---

{
  images.length > 0 && (
    <section
      class="property-gallery"
      aria-label={`Fotos de ${title}`}
    >
      <div class="gallery-container">

        <!-- Área do carrossel -->
        <div class="gallery-viewport">

          <!-- Track -->
          <div class="gallery-track">

            {
              images.map((imagePath, index) => (
                <div class="gallery-slide">
                  <img
                    src={getImageUrl(imagePath)}
                    alt={`${title} - foto ${index + 1}`}
                    width="1200"
                    height="800"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding="async"
                  />
                </div>
              ))
            }

          </div>

          <!-- Botão anterior -->
          {
            images.length > 1 && (
              <button
                type="button"
                class="gallery-button gallery-button-prev"
                aria-label="Foto anterior"
              >
                <span aria-hidden="true">‹</span>
              </button>
            )
          }

          <!-- Botão próximo -->
          {
            images.length > 1 && (
              <button
                type="button"
                class="gallery-button gallery-button-next"
                aria-label="Próxima foto"
              >
                <span aria-hidden="true">›</span>
              </button>
            )
          }

          <!-- Contador -->
          {
            images.length > 1 && (
              <div
                class="gallery-counter"
                aria-live="polite"
              >
                <span class="gallery-current">1</span>
                <span aria-hidden="true"> / </span>
                <span>{images.length}</span>
              </div>
            )
          }

        </div>

      </div>
    </section>
  )
}

<style>
.property-gallery {
  width: 100%;
  height: 100%;
}

.gallery-container {
  width: 100%;
  height: 100%;
}

.gallery-viewport {
  position: relative;

  width: 100%;
  height: 100%;

  overflow: hidden;

  border-radius: 22px;
  background: #f1f1f1;

  touch-action: pan-y;
}

.gallery-track {
  display: flex;

  width: 100%;
  height: 100%;

  transition: transform 0.35s ease;
  will-change: transform;
}

.gallery-slide {
  position: relative;

  flex: 0 0 100%;

  width: 100%;
  height: 100%;

  overflow: hidden;
}

.gallery-slide img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  user-select: none;
  -webkit-user-drag: none;
}
  /*
   * Botões laterais
   */
.gallery-button {
  position: absolute;

  top: 50%;
  z-index: 10;

  display: flex;
  align-items: center;
  justify-content: center;

  width: 44px;
  height: 44px;

  padding: 0;

  border: none;
  border-radius: 50%;

  background: rgba(0, 0, 0, 0.55);
  color: #fff;

  cursor: pointer;

  transform: translateY(-50%);

  transition: background 0.2s ease;
}

.gallery-button:hover {
  background: rgba(0, 0, 0, 0.75);
}

.gallery-button:focus-visible {
  outline: 3px solid #fff;
  outline-offset: 2px;
}

.gallery-button span {
  font-size: 34px;
  font-weight: 300;
  line-height: 1;

  margin-top: -4px;
}

.gallery-button-prev {
  left: 16px;
}

.gallery-button-next {
  right: 16px;
}

  /*
   * Contador: 1 / 7
   */
.gallery-counter {
  position: absolute;

  right: 16px;
  bottom: 16px;

  z-index: 10;

  padding: 6px 10px;

  border-radius: 999px;

  background: rgba(0, 0, 0, 0.6);
  color: #fff;

  font-size: 0.85rem;
  line-height: 1;

  user-select: none;
}

  /*
   * Mobile
   */
  @media (max-width: 800px) {
  .gallery-button {
    width: 38px;
    height: 38px;
  }

  .gallery-button span {
    font-size: 28px;
  }

  .gallery-button-prev {
    left: 10px;
  }

  .gallery-button-next {
    right: 10px;
  }

  .gallery-counter {
    right: 10px;
    bottom: 10px;
  }
}
  /*
   * Usuários que preferem menos animação
   */
  @media (prefers-reduced-motion: reduce) {
    .gallery-track {
      transition: none;
    }

    .gallery-button {
      transition: none;
    }
  }
</style>

<script>
  const galleries = document.querySelectorAll(".property-gallery");

  galleries.forEach((gallery) => {
    const track = gallery.querySelector(".gallery-track");
    const slides = gallery.querySelectorAll(".gallery-slide");
    const previousButton = gallery.querySelector(
      ".gallery-button-prev"
    );
    const nextButton = gallery.querySelector(
      ".gallery-button-next"
    );
    const currentCounter = gallery.querySelector(
      ".gallery-current"
    );

    if (!track || slides.length <= 1) {
      return;
    }

    let currentIndex = 0;

    /*
     * Atualiza a posição do carrossel.
     */
    function updateGallery() {
      track.style.transform =
        `translateX(-${currentIndex * 100}%)`;

      if (currentCounter) {
        currentCounter.textContent =
          String(currentIndex + 1);
      }
    }

    /*
     * Próxima foto.
     */
    function next() {
      currentIndex =
        (currentIndex + 1) % slides.length;

      updateGallery();
    }

    /*
     * Foto anterior.
     */
    function previous() {
      currentIndex =
        (currentIndex - 1 + slides.length) %
        slides.length;

      updateGallery();
    }

    previousButton?.addEventListener(
      "click",
      previous
    );

    nextButton?.addEventListener(
      "click",
      next
    );

    /*
     * Navegação pelo teclado.
     */
    gallery.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        previous();
      }

      if (event.key === "ArrowRight") {
        next();
      }
    });

    /*
     * Swipe no celular.
     */
    let touchStartX = 0;
    let touchStartY = 0;

    gallery.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.changedTouches[0];

        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true }
    );

    gallery.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];

        const deltaX =
          touch.clientX - touchStartX;

        const deltaY =
          touch.clientY - touchStartY;

        /*
         * Ignora movimentos predominantemente verticais.
         */
        if (Math.abs(deltaX) <= Math.abs(deltaY)) {
          return;
        }

        /*
         * Distância mínima para considerar swipe.
         */
        const swipeThreshold = 50;

        if (Math.abs(deltaX) < swipeThreshold) {
          return;
        }

        if (deltaX < 0) {
          next();
        } else {
          previous();
        }
      },
      { passive: true }
    );
  });
</script>