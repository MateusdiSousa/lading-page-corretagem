---
import { getCollection, render } from "astro:content";
import PropertyLayout from "../../layouts/PropertyLayout.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import LeadCTA from "../../components/LeadCTA.astro";
import { WhatsappUrl } from "../../data/site/contato";
import LeadForm from "../../components/LeadForm.astro";

export async function getStaticPaths() {
  const imoveis = await getCollection("imoveis");

  return imoveis.map((imovel) => {
    console.log("IMÓVEL:", imovel.id);

    return {
      params: {
        slug: imovel.id,
      },
      props: {
        imovel,
      },
    };
  });
}

const { imovel } = Astro.props;

const { Content } = await render(imovel);

const { title, description, image, location, property, related, gallery } = imovel.data;
---

<PropertyLayout
  title={title}
  description={description}
  image={image}
  neighborhood={location.neighborhood}
  city={location.city}
  bedrooms={property.bedrooms}
  bathrooms={property.bathrooms}
  parking={property.parking}
  balcony={property.balcony}
  gallery={gallery}
>
  <Content />
  <div class="article-content">
    <slot />

    <LeadCTA
      title="Está pensando em comprar um imóvel?"
      description="Posso te ajudar a entender as opções e fazer uma simulação."
      href={WhatsappUrl}
    />
    <RelatedContent items={related} />
  </div>
</PropertyLayout>
