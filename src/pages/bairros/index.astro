---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const bairros = await getCollection('bairros');

bairros.sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'pt-BR')
);
---

<BaseLayout
  title="Bairros de São Paulo | Penholato"
  description="Conheça os bairros onde atuo e encontre informações sobre localização, infraestrutura e imóveis disponíveis."
>
  <main class="listing-page">

    <section class="listing-hero">
      <div class="container">
        <span class="eyebrow">Guia de bairros</span>

        <h1>
          Encontre seu imóvel
          <span>na região certa.</span>
        </h1>

        <p>
          Conheça os principais bairros da Zona Sul de São Paulo,
          suas características, localização, infraestrutura e opções
          de imóveis.
        </p>
      </div>
    </section>

    <section class="listing-content">
      <div class="container">

        {bairros.length > 0 ? (
          <div class="card-grid">
            {bairros.map((bairro) => (
              <a
                href={`/bairros/${bairro.data.slug}`}
                class="content-card"
              >

                {bairro.data.image && (
                  <div class="card-image">
                    <img
                      src={bairro.data.image}
                      alt={`Bairro ${bairro.data.title}`}
                      loading="lazy"
                    />
                  </div>
                )}

                <div class="card-body">

                  <span class="card-category">
                    {bairro.data.city} · {bairro.data.state}
                  </span>

                  <h2>{bairro.data.title}</h2>

                  <p>
                    {bairro.data.description}
                  </p>

                  <span class="card-link">
                    Conhecer o bairro →
                  </span>

                </div>

              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>Nenhum bairro cadastrado ainda.</h2>
            <p>
              Em breve você encontrará novos guias de bairros aqui.
            </p>
          </div>
        )}

      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .listing-page {
    background: #fafaf8;
    min-height: 100vh;
  }

  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .listing-hero {
    padding: 100px 0 70px;
    border-bottom: 1px solid #e8e8e4;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 18px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1f5c45;
  }

  h1 {
    max-width: 750px;
    margin: 0;
    font-size: clamp(42px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #181818;
  }

  h1 span {
    display: block;
    color: #1f5c45;
  }

  .listing-hero p {
    max-width: 680px;
    margin: 28px 0 0;
    font-size: 18px;
    line-height: 1.7;
    color: #666;
  }

  .listing-content {
    padding: 70px 0 100px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .content-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: white;
    border: 1px solid #e8e8e4;
    border-radius: 18px;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .content-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
  }

  .card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f1f1ed;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .content-card:hover .card-image img {
    transform: scale(1.04);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    padding: 26px;
  }

  .card-category {
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #1f5c45;
  }

  .card-body h2 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #181818;
  }

  .card-body p {
    margin: 0;
    color: #666;
    line-height: 1.6;
  }

  .card-link {
    margin-top: 25px;
    font-size: 14px;
    font-weight: 700;
    color: #1f5c45;
  }

  .empty-state {
    padding: 80px 20px;
    text-align: center;
  }

  .empty-state h2 {
    margin-bottom: 10px;
  }

  .empty-state p {
    color: #666;
  }

  @media (max-width: 800px) {
    .listing-hero {
      padding: 70px 0 50px;
    }

    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .container {
      width: min(100% - 28px, 1120px);
    }

    .card-grid {
      grid-template-columns: 1fr;
    }

    .listing-content {
      padding-top: 45px;
    }
  }
</style>