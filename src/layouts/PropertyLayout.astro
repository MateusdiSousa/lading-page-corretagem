---
import BaseLayout from "./BaseLayout.astro";
import LeadCTA from "../components/LeadCTA.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  neighborhood?: string;
  city?: string;
  bedrooms?: number;
  bathrooms?: number;
  parking?: number;
  balcony?: boolean;
  whatsappMessage?: string;
}

const {
  title,
  description,
  image,
  neighborhood,
  city = "São Paulo",
  bedrooms,
  bathrooms,
  parking,
  balcony,
  whatsappMessage,
} = Astro.props;

const phone = "5511999999999";

const message =
  whatsappMessage ??
  `Olá, Penholato! Quero saber mais sobre ${title}.`;

const whatsappUrl =
  `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
>
  <article class="property-page">

    <div class="container">

      <!-- Breadcrumb -->

      <div class="breadcrumbs">
        <a href="/">Início</a>
        <span>/</span>
        <a href="/imoveis/">Imóveis</a>
        <span>/</span>
        <span>{title}</span>
      </div>


      <!-- Header -->

      <header class="property-header">

        {
          neighborhood && (
            <span class="eyebrow">
              {neighborhood} · {city}
            </span>
          )
        }

        <h1>{title}</h1>

        <p class="property-description">
          {description}
        </p>

      </header>


      <!-- Hero -->

      <section class="property-hero">

        <div class="property-image">

          {
            image ? (
              <img
                src={image}
                alt={title}
              />
            ) : (
              <div class="image-placeholder">
                Imóvel
              </div>
            )
          }

        </div>


        <aside class="property-summary">

          <span class="summary-label">
            Sobre o imóvel
          </span>

          <h2>
            Encontre seu próximo lar
          </h2>

          <div class="property-features">

            {
              bedrooms !== undefined && (
                <div class="feature">
                  <strong>{bedrooms}</strong>
                  <span>dormitórios</span>
                </div>
              )
            }

            {
              bathrooms !== undefined && (
                <div class="feature">
                  <strong>{bathrooms}</strong>
                  <span>banheiro{bathrooms > 1 ? "s" : ""}</span>
                </div>
              )
            }

            {
              parking !== undefined && (
                <div class="feature">
                  <strong>{parking}</strong>
                  <span>vaga{parking > 1 ? "s" : ""}</span>
                </div>
              )
            }

            {
              balcony && (
                <div class="feature">
                  <strong>✓</strong>
                  <span>varanda</span>
                </div>
              )
            }

          </div>


          <a
            href={whatsappUrl}
            class="primary-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            Quero saber mais
          </a>

          <p class="summary-note">
            Atendimento personalizado pelo WhatsApp.
          </p>

        </aside>

      </section>


      <!-- Conteúdo do Markdown -->

      <div class="property-content">

        <div class="property-main">
          <slot />
        </div>

      </div>


      <!-- CTA -->

      <LeadCTA
        title="Gostou desse imóvel?"
        description="Me chame no WhatsApp para consultar valores, disponibilidade e condições."
        href={whatsappUrl}
      />

    </div>

  </article>
</BaseLayout>